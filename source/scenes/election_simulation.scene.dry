{!<svg id="status_parliament" style="width: 100%; height: 280px; display: block; margin: 0 auto;"></svg>!}

{!<svg id="election-results-map" viewBox="0 0 450 850" width="280" height="530" style="display:block; margin:auto; border: 3px solid #3B3B3B;">
  <style>
    .election-district { stroke: #000000; stroke-width: 2px; }
  </style>
