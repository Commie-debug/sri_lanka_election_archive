title: Election Simulation
set-bg: img/elections.jpg
new-page: true

= Election Archive

Herein contains an archive of every election (and singular referendum) in independent Sri Lankan history (including the Dominion of Ceylon) until 1989.

- @timeline: View all elections in chronological order (1947-->2024)......
- @presidential_timeline: View all presidential elections in chronological order (1982-->2024)......
- @parliament_timeline: View all parliamentary elections in chronological order (1947-->2024)......
- @selection: Browse elections freely.....
- @return: Leave...

@presidential_timeline
go-to: 1982

@parliament_timeline
go-to: 1947


@selection
new-page: true

= Selection Menu

- @1947: 1947 Parliamentary Election 
- @1952: 1952 Parliamentary Election
- @1956: 1956 Parliamentary Election
- @1960_March: March 1960 Parliamentary Election
- @1960_July: July 1960 Parliamentary Election
- @1965: 1965 Parliamentary Election
- @1970: 1970 Parliamentary Election
- @1977: 1977 Parliamentary Election
- @1982: 1982 Presidential Election
- @1983: 1983 National Referendum
- @1988: 1988 Presidential Election
- @1989: 1989 Parliamentary Election
- @1994_Parliament: 1994 Parliamentary Election
- @1994_President: 1994 Presidential Election
- @1999: 1999 Presidential Election
- @2000: 2000 Parliamentary Election
- @2001: 2001 Parliamentary Election
- @2004: 2004 Parliamentary Election
- @2005: 2005 Presidential Election
- @2010_President: 2010 Presidential Election
- @2010_Parliament: 2010 Parliamentary Election
- @2015_President: 2015 Presidential Election
- @2015_Parliament: 2015 Parliamentary Election
- @2019: 2019 Presidential Election
- @2020: 2020 Parliamentary Election
- @2022: 2022 Indirect Presidential Election
- @2024_President: 2024 Presidential Election
- @2024_Parliament: 2024 Parliamentary Election
- @return: Leave..

@timeline
go-to: 1947

@1947
new-page: true
on-arrival: {!
    var _newData = [];
    function _addP(id, legend, seats) {
        if (seats && seats > 0) _newData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    _addP('unp',  'UNP', 42);
    _addP('lssp',   'LSSP',  10);
    _addP('bsp-blp',   'BSP-BLP',  5);
    _addP('cpc',   'CPC',  3);
    _addP('actc',   'ACTC',  7);
    _addP('cic',   'CIC',  6);
    _addP('clp',   'CLP',  1);
    _addP('independent',  'Independent', 21);
    _addP('appointed',  'Appointed', 6);
    var _newSig = JSON.stringify(_newData.map(function(p){ return p.id + p.seats; }));
    var _changed = (_newSig !== window._parliSig);
    window._parliData = _newData;
    if (_changed) { window._parliSig = _newSig; window._parliAnimate = true; }
    else { window._parliAnimate = false; }
!}
on-display: {!
(function() {
    if (!d3 || !d3.parliament || !window._parliData || window._parliData.length === 0) return;
    var el = document.getElementById('status_parliament');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 450;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.50));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.50)).innerRadiusCoef(0.4);
    var animate = window._parliAnimate;
    parl.enter.fromCenter(animate).smallToBig(animate);
    parl.exit.toCenter(animate).bigToSmall(animate);
    d3.select('#status_parliament').datum(window._parliData).call(parl);
})();
!}

